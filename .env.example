# Groq - powers the LLM inference for all 3 agents (get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Exa - neural web search for live exploit/threat chatter (get key at exa.ai)
EXA_API_KEY=your_exa_api_key_here

# NVD - optional. Without a key you're rate-limited to ~5 requests / 30s.
# Request one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here_optional
